  <!-- ═══════════════════════════════════════════════════
       THE GET KINDER SYSTEM
  ═══════════════════════════════════════════════════════ -->
  <section id="system" style="background:#fff;padding:112px 0;">
    <div class="container" style="max-width:1200px;">
      <div style="margin-bottom:48px;">
        <div class="gk-eyebrow">The Get Kinder system</div>
        <h2 class="gk-sh-title">A working system for turning <span style="font-family:'Lora',serif;font-style:italic;font-weight:500;color:#FF5656;">information into evidence</span>.</h2>
        <p class="gk-sh-body" style="max-width:800px;">Get Kinder combines a guided Assessment, a practical Knowledge Studio, a reusable Impact Evidence Library, and Kinder AI™. Each part solves a different part of the reporting problem.</p>
      </div>
      <div class="row g-4">
        <div class="col-12 col-md-4">
          <div style="background:#fff;border:1px solid #e3e4e8;border-radius:14px;padding:28px;height:100%;">
            <div style="width:40px;height:40px;border-radius:10px;background:#f1f3f7;display:flex;align-items:center;justify-content:center;margin-bottom:16px;"><i data-lucide="monitor" style="width:18px;height:18px;color:#455A7C;"></i></div>
            <div style="font-family:'Roboto',sans-serif;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#FF5656;font-weight:600;margin-bottom:8px;">Knowledge Studio</div>
            <h3 style="font-family:'Poppins',sans-serif;font-weight:600;font-size:17px;color:#283853;margin:0 0 10px;line-height:1.3;">Organize what you have. Improve what happens next.</h3>
            <p style="font-family:'Roboto',sans-serif;font-size:14px;color:#4d525e;line-height:1.6;margin:0 0 10px;">The Knowledge Studio is where your organization can see what it has shared, understand what the information can support, resolve important questions, and follow practical steps for improving future evidence capture.</p>
            <p style="font-family:'Roboto',sans-serif;font-size:14px;color:#4d525e;line-height:1.6;margin:0;">It is not intended to run your programs. It helps your team structure how it captures, reviews, and uses evidence of program impact.</p>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div style="background:#fff;border:1px solid #e3e4e8;border-radius:14px;padding:28px;height:100%;">
            <div style="width:40px;height:40px;border-radius:10px;background:#f1f3f7;display:flex;align-items:center;justify-content:center;margin-bottom:16px;"><i data-lucide="database" style="width:18px;height:18px;color:#455A7C;"></i></div>
            <div style="font-family:'Roboto',sans-serif;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#FF5656;font-weight:600;margin-bottom:8px;">Impact Evidence Library</div>
            <h3 style="font-family:'Poppins',sans-serif;font-weight:600;font-size:17px;color:#283853;margin:0 0 10px;line-height:1.3;">Keep reviewed evidence ready for appropriate reuse.</h3>
            <p style="font-family:'Roboto',sans-serif;font-size:14px;color:#4d525e;line-height:1.6;margin:0 0 10px;">When information is understood, reviewed, and approved for use, eligible evidence can become part of your Impact Evidence Library.</p>
            <p style="font-family:'Roboto',sans-serif;font-size:14px;color:#4d525e;line-height:1.6;margin:0;">The Library preserves important sources, definitions, limitations, review decisions, and permitted uses so your organization does not have to rediscover them during every reporting cycle.</p>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div style="background:#455a7c;border-radius:14px;padding:28px;height:100%;">
            <div style="width:40px;height:40px;border-radius:10px;background:rgba(255,86,86,.16);display:flex;align-items:center;justify-content:center;margin-bottom:16px;"><i data-lucide="sparkles" style="width:18px;height:18px;color:#ff8c83;"></i></div>
            <div style="font-family:'Roboto',sans-serif;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#ff8c83;font-weight:600;margin-bottom:8px;">Kinder AI™ (KAI)</div>
            <h3 style="font-family:'Poppins',sans-serif;font-weight:600;font-size:17px;color:#fff;margin:0 0 10px;line-height:1.3;">KAI assists. Your organization decides.</h3>
            <p style="font-family:'Roboto',sans-serif;font-size:14px;color:#dfe3ec;line-height:1.6;margin:0 0 10px;">Kinder AI™ (KAI) is the AI built into the Knowledge Studio. KAI helps users understand findings, identify gaps and inconsistencies, answer questions, and work with evidence eligible for the intended use.</p>
            <p style="font-family:'Roboto',sans-serif;font-size:14px;color:#dfe3ec;line-height:1.6;margin:0 0 10px;">KAI does not independently determine organizational truth or approve your organization's evidence and claims. Your authorized team remains responsible for definitions, interpretations, conclusions, approvals, and permitted uses.</p>
            <p style="font-family:'Roboto',sans-serif;font-size:14px;color:#dfe3ec;line-height:1.6;margin:0;">KAI is part of the Knowledge Studio — not a companion, character, mascot, or separate product.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       PROCESS
  ═══════════════════════════════════════════════════════ -->
  <section id="how" style="background:#f4f4f4;padding:112px 0;">
    <div class="container" style="max-width:1200px;">
      <div style="margin-bottom:32px;">
        <div class="gk-eyebrow">Process</div>
        <h2 class="gk-sh-title">From scattered records to <span style="font-family:'Lora',serif;font-style:italic;font-weight:500;color:#FF5656;">reusable evidence</span>.</h2>
      </div>
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:32px;flex-wrap:wrap;">
        <% ['Understand','Build','Reuse'].forEach(function(w, i, arr) { %>
        <span style="font-family:'Poppins',sans-serif;font-weight:600;font-size:22px;color:#283853;"><%= w %></span>
        <% if (i < arr.length-1) { %><i data-lucide="arrow-right" style="width:18px;height:18px;color:#dcb38c;"></i><% } %>
        <% }); %>
      </div>
      <div class="row g-4">
        <% [
          {n:'1', h:'Understand what you already have', p:['We begin with the information, reporting requirements, and evidence practices surrounding one or two priority programs.','The goal is to identify useful sources, reporting risks, missing definitions, and the strongest opportunities for improvement.']},
          {n:'2', h:'Build your evidence foundation',    p:['Existing information is organized, reviewed, and connected to the programs, activities, outputs, and outcomes it can appropriately support.','Practical improvements are identified for evidence that is currently difficult or impossible to capture.']},
          {n:'3', h:'Reuse evidence with confidence',    p:['Reviewed and approved evidence can support future reports and communications without requiring your team to reconstruct the entire story from the beginning.']}
        ].forEach(function(s) { %>
        <div class="col-12 col-md-4">
          <div style="background:#fff;border:1px solid #e3e4e8;border-radius:14px;padding:24px;height:100%;">
            <span style="font-family:'Poppins',sans-serif;font-weight:800;font-size:38px;color:#f1f3f7;letter-spacing:-0.04em;line-height:1;"><%= s.n %></span>
            <h3 style="font-family:'Poppins',sans-serif;font-weight:600;font-size:17px;color:#283853;margin:8px 0;line-height:1.3;"><%= s.h %></h3>
            <% s.p.forEach(function(t) { %><p style="font-family:'Roboto',sans-serif;font-size:14px;color:#4d525e;line-height:1.6;margin:0 0 8px;"><%= t %></p><% }); %>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       CUSTOMER OUTCOMES
  ═══════════════════════════════════════════════════════ -->
  <section style="background:#fff;padding:112px 0;">
