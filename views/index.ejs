  <script type="text/javascript" id="hs-script-loader" async defer src="//js-na3.hs-scripts.com/342094649.js"></script>

  <!-- AOS -->
  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script>
    (function initAos() {
      function startAos() {
        if (window.AOS && typeof window.AOS.init === 'function') {
          window.AOS.init({ duration: 600, easing: 'ease', once: true, anchorPlacement: 'top-bottom' });
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', startAos, { once: true });
      } else { startAos(); }
    })();
  </script>
</body>
</html>
