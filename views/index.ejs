  <!-- ═══════════════════════════════════════════════════
       REPORTING READINESS APPLICATION MODAL
  ═══════════════════════════════════════════════════════ -->
  <div class="modal fade" id="rrModal" tabindex="-1" role="dialog"
       aria-labelledby="rrModalTitle" aria-modal="true" aria-describedby="rrModalDesc">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content">

        <!-- HEADER -->
        <div class="modal-header rrm-header">
          <div class="rrm-header-top">
            <div style="flex:1;min-width:0;">
              <div class="gk-eyebrow" style="margin-bottom:8px;">Design partner application</div>
              <h2 class="rrm-title" id="rrModalTitle">Apply for a Reporting Readiness Call</h2>
              <p class="rrm-intro" id="rrModalDesc">We're selecting 5 nonprofit design partners for a free Impact Reporting &amp; Data Readiness Assessment. Answer a few questions so we can understand your reporting needs and confirm whether the assessment is a strong fit.</p>
              <p class="rrm-microcopy">Selected nonprofits receive a 1–2 week review, a 10–15 page assessment, and a 60-minute readout presentation. The call confirms fit before any materials are reviewed.</p>
            </div>
            <button class="rrm-close-btn" id="rrCloseBtn" type="button" aria-label="Close application form">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
          <!-- Progress indicator -->
          <div class="rrm-progress" role="group" aria-label="Application steps">
            <div class="rrm-progress-step is-active" id="rrProg1">
              <span class="rrm-progress-step-num" aria-hidden="true">1</span>
              <span class="rrm-progress-step-label">Organization fit</span>
            </div>
            <div class="rrm-progress-step" id="rrProg2">
              <span class="rrm-progress-step-num" aria-hidden="true">2</span>
              <span class="rrm-progress-step-label">Reporting pressure</span>
            </div>
            <div class="rrm-progress-step" id="rrProg3">
              <span class="rrm-progress-step-num" aria-hidden="true">3</span>
              <span class="rrm-progress-step-label">Data readiness</span>
            </div>
          </div>
        </div>

        <!-- BODY -->
        <div class="modal-body rrm-body">

          <!-- ── STEP 1 ── -->
          <div id="rrStep1">
            <h3 class="rrm-step-heading">Tell us about your organization</h3>
            <p class="rrm-step-desc">First, we'll confirm basic fit for the design partner cohort.</p>

            <div class="rrm-row">
              <div class="rrm-field">
                <label class="rrm-label" for="rrOrgName">Organization name <span class="rrm-req" aria-label="required">*</span></label>
                <input class="rrm-input" type="text" id="rrOrgName" placeholder="Organization name" autocomplete="organization">
                <div class="rrm-err" id="rrOrgNameErr">Please enter your organization name.</div>
              </div>
              <div class="rrm-field">
                <label class="rrm-label" for="rrWebsite">Website <span class="rrm-req" aria-label="required">*</span></label>
                <input class="rrm-input" type="text" id="rrWebsite" placeholder="https://yourorganization.org" autocomplete="url">
                <div class="rrm-err" id="rrWebsiteErr">Please enter a valid website URL.</div>
              </div>
            </div>

            <div class="rrm-row">
              <div class="rrm-field">
                <label class="rrm-label" for="rrContactName">Your name <span class="rrm-req" aria-label="required">*</span></label>
                <input class="rrm-input" type="text" id="rrContactName" placeholder="Full name" autocomplete="name">
                <div class="rrm-err" id="rrContactNameErr">Please enter your full name.</div>
              </div>
              <div class="rrm-field">
                <label class="rrm-label" for="rrRole">Your role <span class="rrm-req" aria-label="required">*</span></label>
                <select class="rrm-select" id="rrRole">
                  <option value="" disabled selected>Select your role</option>
                  <option>Executive Director / CEO</option>
                  <option>Development / Fundraising</option>
                  <option>Programs</option>
                  <option>Operations</option>
                  <option>Finance</option>
                  <option>Evaluation / Impact</option>
                  <option>Board member</option>
                  <option>Other</option>
                </select>
                <div class="rrm-err" id="rrRoleErr">Please select your role.</div>
              </div>
            </div>

            <div class="rrm-field" id="rrRoleOtherWrap" style="display:none;">
              <label class="rrm-label" for="rrRoleOther">Please specify your role <span class="rrm-req" aria-label="required">*</span></label>
              <input class="rrm-input" type="text" id="rrRoleOther" placeholder="Your role">
              <div class="rrm-err" id="rrRoleOtherErr">Please specify your role.</div>
            </div>

            <div class="rrm-row">
              <div class="rrm-field">
                <label class="rrm-label" for="rrEmail">Email <span class="rrm-req" aria-label="required">*</span></label>
                <input class="rrm-input" type="email" id="rrEmail" placeholder="name@organization.org" autocomplete="email">
                <div class="rrm-err" id="rrEmailErr">Please enter a valid email address.</div>
              </div>
              <div class="rrm-field">
                <label class="rrm-label" for="rrPhone">Phone number</label>
                <input class="rrm-input" type="tel" id="rrPhone" placeholder="Optional" autocomplete="tel">
              </div>
            </div>

            <div class="rrm-row">
              <div class="rrm-field">
                <label class="rrm-label" for="rrBudget">Annual operating budget <span class="rrm-req" aria-label="required">*</span></label>
                <select class="rrm-select" id="rrBudget">
                  <option value="" disabled selected>Select budget range</option>
                  <option>Under $250K</option>
                  <option>$250K–$500K</option>
                  <option>$500K–$1M</option>
                  <option>$1M–$2M</option>
                  <option>$2M–$5M</option>
                  <option>$5M+</option>
                  <option>Not sure</option>
                </select>
