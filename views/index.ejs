  <section style="background:#f4f4f4;padding:112px 0;">
    <div class="container" style="max-width:1200px;">
      <div class="row g-5 align-items-start">
        <!-- Left: copy -->
        <div class="col-12 col-lg-6">
          <div class="gk-eyebrow">The problem</div>
          <h2 style="font-family:'Poppins',sans-serif;font-weight:600;font-size:clamp(26px,3vw,36px);letter-spacing:-0.02em;color:#455a7c;margin:0;line-height:1.18;">
            Your impact is not the problem.
            <span style="font-family:'Lora',serif;font-style:italic;font-weight:500;color:#FF5656;"> Proving it</span> is.
          </h2>
          <p style="margin-top:22px;font-family:'Roboto',sans-serif;font-size:16px;line-height:1.65;color:#4d525e;">
            Most nonprofits are already collecting valuable information. But it lives in different places, uses inconsistent definitions, and rarely connects cleanly to what funders ask organizations to demonstrate.
          </p>
          <p style="margin-top:18px;font-family:'Roboto',sans-serif;font-size:15.5px;line-height:1.7;color:#4d525e;">That creates a familiar cycle:</p>
          <div style="margin-top:22px;padding-left:18px;border-left:3px solid #FF5656;font-family:'Lora',serif;font-style:italic;font-weight:500;font-size:19px;line-height:1.45;color:#455A7C;">
            The work is real. The evidence system behind it is missing.
          </div>
        </div>
        <!-- Right: the cycle -->
        <div class="col-12 col-lg-6">
          <div style="display:flex;flex-direction:column;gap:12px;">
            <% [
              {icon:'file-search', item:'Every report begins with another search through old files.'},
              {icon:'brain',       item:'Staff reconstruct results from memory.'},
              {icon:'search-x',    item:'Important outcomes are underreported because supporting evidence is difficult to find.'},
              {icon:'puzzle',      item:'Claims are weakened by incomplete, inconsistent, or inaccessible information.'},
              {icon:'user-minus',  item:'Organizational knowledge disappears when staff or volunteers leave.'}
            ].forEach(function(row) { %>
            <div style="display:flex;gap:14px;align-items:center;background:#fff;border:1px solid #e3e4e8;border-radius:12px;padding:16px 18px;">
              <span style="width:36px;height:36px;border-radius:10px;background:#fff1f0;display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i data-lucide="<%= row.icon %>" style="width:17px;height:17px;color:#FF5656;"></i></span>
              <span style="font-family:'Roboto',sans-serif;font-size:15px;color:#4d525e;line-height:1.5;"><%= row.item %></span>
            </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       CORE VALUE
  ═══════════════════════════════════════════════════════ -->
  <section style="background:#fff1f0;padding:112px 0;">
    <div class="container" style="max-width:1200px;">
      <div style="margin-bottom:48px;">
        <div class="gk-eyebrow">Core value</div>
        <h2 class="gk-sh-title">Build your evidence once. <span style="font-family:'Lora',serif;font-style:italic;font-weight:500;color:#FF5656;">Strengthen it</span> every reporting cycle.</h2>
        <p class="gk-sh-body" style="max-width:760px;">Get Kinder helps your organization move from one-off reporting scrambles to a reusable evidence system.</p>
      </div>
      <div class="row g-4">
        <% [
          {icon:'search',        h:'Find what already exists',          p:'Bring together the reports, spreadsheets, program records, surveys, stories, and other information your organization already holds.'},
