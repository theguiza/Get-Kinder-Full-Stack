  ═══════════════════════════════════════════════════════ -->
  <section id="trust" style="background:#283853;padding:112px 0;">
    <div class="container" style="max-width:1200px;">
      <div class="row g-5 align-items-start">
        <!-- Left -->
        <div class="col-12 col-lg-5">
          <div class="gk-eyebrow gk-eyebrow-dark">Trust and control</div>
          <h2 style="font-family:'Poppins',sans-serif;font-weight:600;font-size:clamp(26px,3vw,38px);letter-spacing:-0.02em;color:#fff;margin:0;line-height:1.15;">
            Your evidence. Your judgment.
            <span style="font-family:'Lora',serif;font-style:italic;font-weight:500;color:#ffbbbb;"> Your control.</span>
          </h2>
          <p style="margin-top:22px;font-family:'Roboto',sans-serif;font-size:16px;color:#dfe3ec;line-height:1.65;max-width:460px;">
            Nonprofits should not have to choose between useful technology and responsible handling of their information.
          </p>
          <div style="margin-top:28px;">
            <a href="/home/book" class="gk-cta-primary">Book a Reporting Readiness Call <i data-lucide="arrow-right" style="width:15px;height:15px;"></i></a>
          </div>
          <div style="margin-top:36px;padding:18px 20px;background:rgba(255,255,255,0.04);border-radius:10px;border:1px solid rgba(255,255,255,0.08);display:flex;align-items:center;gap:14px;max-width:460px;">
            <i data-lucide="shield-check" style="width:22px;height:22px;color:#ff8c83;flex-shrink:0;"></i>
            <p style="font-family:'Roboto',sans-serif;font-size:13.5px;color:#dfe3ec;line-height:1.5;margin:0;">Every data-handling step is documented in writing before any materials are reviewed.</p>
          </div>
        </div>
        <!-- Right: trust items -->
        <div class="col-12 col-lg-7">
          <div class="row g-3">
            <% [
              {icon:'user-check',    h:'AI assists. People decide.',                                   p:'KAI may help explain findings, identify gaps, answer questions, and support evidence-grounded work. Authorized people review and approve what can be used.'},
              {icon:'file-text',     h:'Uploading information does not automatically make it evidence.',p:'Information must be understood, reviewed, and connected to an appropriate source before it can support an external claim.'},
              {icon:'ban',           h:'Unsupported claims remain unsupported.',                        p:'Get Kinder should identify missing, conflicting, or incomplete evidence rather than inventing a stronger story.'},
              {icon:'lock',          h:'Information is used for defined purposes.',                     p:'Sensitive information, consent restrictions, intended uses, and appropriate audiences must be considered before evidence is reused.'},
              {icon:'shield-check',  h:'Your organization retains control.',                            p:'Ownership, access, deletion, export, and account-closure terms must be clearly stated before an organization shares substantive information.'},
              {icon:'file-signature',h:'Data processing agreement.',                                    p:'Before any materials are reviewed, we define how information is handled, accessed, retained, deleted, or returned.'}
            ].forEach(function(t) { %>
            <div class="col-12 col-sm-6">
              <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:22px;height:100%;">
                <div style="width:34px;height:34px;border-radius:8px;background:rgba(255,86,86,0.12);display:flex;align-items:center;justify-content:center;margin-bottom:12px;"><i data-lucide="<%= t.icon %>" style="width:16px;height:16px;color:#ff8c83;"></i></div>
                <div style="font-family:'Poppins',sans-serif;font-weight:600;font-size:16px;color:#fff;margin-bottom:6px;"><%= t.h %></div>
                <p style="font-family:'Roboto',sans-serif;font-size:13.5px;color:#b5bdcb;line-height:1.55;margin:0;"><%= t.p %></p>
              </div>
            </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
  </section>

