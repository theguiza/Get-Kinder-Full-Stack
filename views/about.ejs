    <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show auto-dismiss" role="alert">
      Registration successful! Welcome to Get Kinder 🌟
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <% if (loginSuccess && name) { %>
    <div class="alert alert-success alert-dismissible fade show auto-dismiss" role="alert">
      Welcome back, <%= name %>! 🎉
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
      <%- include("partials/site-header", { currentPage: "about" }) %>

<!-- ══ HERO ══ -->
<section class="about-hero">
  <div class="container">
    <div class="row align-items-center g-5">

      <div class="col-lg-7 about-fade">
        <span class="about-section-label">About Get Kinder</span>
        <h1 class="about-hero__headline">
          We&rsquo;re building the <em>evidence layer</em> Canada&rsquo;s social sector has been missing.
        </h1>
        <p class="about-hero__sub">
          Strong programs should not be held back by scattered records and reporting systems that force
          nonprofit teams to rebuild their evidence for every deadline. Get Kinder helps organizations turn
          information they already hold into a reviewed, reusable evidence foundation for funder reports,
          grant applications, board updates, and impact communications.
        </p>
        <div class="d-flex gap-3 flex-wrap">
          <a href="/home/book" class="about-btn-primary">Apply for a Reporting Readiness Call →</a>
          <a href="/home/how-it-works" class="about-btn-outline">See How Get Kinder Works</a>
        </div>
      </div>

      <div class="col-lg-5 about-fade" style="transition-delay:0.15s">
        <div class="about-plain-card">
          <span class="about-plain-card__eyebrow">In plain terms</span>
          <h2 class="about-plain-card__title">What is Get Kinder?</h2>
          <p class="about-plain-card__body">
            Get Kinder is building a governed evidence system for Canadian nonprofits. Its
            <a href="/home/how-it-works">Knowledge Studio</a> helps organizations understand scattered
            information, identify evidence gaps, review important claims, and preserve approved evidence in
            a reusable <a href="/home/how-it-works">Impact Evidence Library</a>. Kinder AI&trade; (KAI)
            assists inside the Knowledge Studio, while authorized humans remain responsible for definitions,
            interpretations, conclusions, approvals, and <a href="/home/data-safety">permitted uses</a>.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ══ WE LIVED IT ══ -->
<section class="about-lived">
  <div class="container">

    <div class="about-lived__row about-fade">
      <div class="about-lived__text">
        <h2 class="about-lived__title">We understood the problem because we had lived it.</h2>
        <p>
          Our founding team experienced federal grant reporting from the volunteer side&mdash;reconciling
          field counts with national registries, chasing timesheets, and translating frontline records into
          the language and formats funders required, all on unpaid time.
        </p>
      </div>
      <div class="about-lived__media about-lived__media--photo">
        <img src="/images/volunteer_coordinator.jpg" alt="A volunteer coordinator greeting a guest at a community distribution event">
      </div>
    </div>

    <div class="about-lived__row about-lived__row--reverse about-fade" style="transition-delay:0.1s">
      <div class="about-lived__text">
        <p>
          We soon recognized the same problem across the social sector at a much larger scale. Frontline
          teams were already capturing valuable information in case notes, program logs, spreadsheets,
          surveys, financial records, and client narratives. But the meaning, source, limitations, and
          reporting value of that information were rarely preserved in one usable system.
        </p>
        <p>
          When reporting deadlines arrived, teams had to find it, interpret it, reconcile it, and reshape it
          for each funder&mdash;again and again.
        </p>
      </div>
      <div class="about-lived__media about-lived__media--photo about-lived__media--contain">
        <img src="/images/magic-evidence-premium-outcomes.png" alt="Frontline records turning into funding-ready evidence &mdash; case notes, spreadsheets, and program logs">
      </div>
    </div>

  </div>
</section>

<!-- ══ BELIEF STRIP ══ -->
<div class="about-belief">
  <div class="container">
    <p class="about-belief__text about-fade">
      The work was real. The impact was real. <em>The evidence was trapped.</em>
    </p>
  </div>
</div>

<!-- ══ PROGRESSION ══ -->
<section class="about-progress">
  <div class="container">
    <div class="about-fade">
      <span class="about-progress__eyebrow">That is why we are building Get Kinder</span>
      <h2 class="about-progress__title">From the records you already have to evidence your team can stand behind.</h2>
      <p class="about-progress__body">
        The <a href="/home/how-it-works">Knowledge Studio</a> helps organizations understand what their
        information can support, identify gaps, and review important evidence and claims. Approved evidence
        can become part of a reusable <a href="/home/how-it-works">Impact Evidence Library</a>, with Kinder
        AI&trade; (KAI) assisting and <a href="/home/data-safety">authorized people remaining in control</a>.
      </p>
      <div class="about-progress__steps">
        <% [
          "organizational records",
          "understood sources",
          "reviewed evidence",
          "approved claims",
          "audience-appropriate drafts"
        ].forEach(function(label, i, arr) { %>
          <span class="about-progress__step"><%= label %></span>
          <% if (i < arr.length - 1) { %><span class="about-progress__arrow">→</span><% } %>
        <% }); %>
      </div>
      <p class="about-progress__note">Records never become evidence automatically. KAI proposes; authorized humans decide.</p>
    </div>
  </div>
</section>

<!-- ══ CLOSING CTA ══ -->
<section class="about-closing">
  <div class="container">
    <h2 class="about-closing__headline">
      Nonprofits should not have to choose between <em>doing the work</em> and <em>proving it</em>.
    </h2>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
      <a href="/home/book" class="about-btn-primary">Apply for a Reporting Readiness Call →</a>
      <a href="/home/how-it-works" class="about-btn-secondary">See How Get Kinder Works</a>
    </div>
    <p class="about-closing__caption">
      AI-assisted. Human-reviewed. Your evidence stays under your organization's control.
    </p>
  </div>
</section>
  <%- include("partials/site-footer") %>

  <script>
    if (window.lucide) window.lucide.createIcons();
    const _aboutObserver = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          _aboutObserver.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.about-fade').forEach(el => _aboutObserver.observe(el));
  </script>
