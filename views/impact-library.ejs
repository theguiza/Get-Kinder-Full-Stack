<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Impact Library</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/gk-design-tokens.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="icon" href="/images/favicon.png" sizes="32x32" type="image/png" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7" crossorigin="anonymous"/>
  <style>
    /*
      /impact-library renders inside the standard site shell
      (partials/site-header + partials/site-footer), in the same include
      order as kai-review-cockpit.ejs. Bootstrap is kept because the site
      header and the existing ImpactEvidenceLibrary component both rely on it.

      Unlike document-style pages, the product shell (.gk-shell-root,
      gk-design-tokens.css) is a full-bleed app, so it starts directly below
      the fixed site header: the body offset equals that header's natural
      height (80px logo + Bootstrap navbar and brand vertical padding =
      106px), the shared "body > header + *" breathing-room margin in
      style.css is cancelled for the mount point only, and the shell fills
      the rest of the viewport. On mobile, body bottom padding keeps the
      shell's fixed bottom tab bar from covering the site footer.
    */
    :root { --gk-site-header-height: 106px; }
    body { padding-top: var(--gk-site-header-height); }
    #impact-evidence-library-root { margin-top: 0; }
    .gk-shell-root { height: calc(100vh - var(--gk-site-header-height)); }
    @media (max-width: 767.98px) {
      body { padding-bottom: 64px; }
    }
    /* Preserved from this view's previous markup: ImpactEvidenceLibrary.jsx
       still uses these classNames throughout. */
    .admin-title {
      color: #455a7c;
      font-weight: 700;
      font-size: 1.75rem;
    }
    .admin-card {
      background: #fff;
      border: 1px solid #e6e9f0;
      border-radius: 12px;
      padding: 1rem 1.25rem;
      box-shadow: 0 1px 2px rgba(16,24,40,.04);
    }
  </style>
</head>
<body>
  <%- include("partials/site-header", { currentPage: "impact-library" }) %>

  <div id="impact-evidence-library-root"></div>

  <%- include("partials/site-footer") %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js" integrity="sha384-k6d4wzSIapyDyv1kpU366/PK5hCdSbCRGRCMv+eplOQJWyd1fbcAu9OCUj5zNLiq" crossorigin="anonymous"></script>
  <script src="/js/bundles/entry.js?<%= assetTag %>"></script>
  <script>
    window.renderImpactEvidenceLibrary("#impact-evidence-library-root");
  </script>
</body>
</html>
